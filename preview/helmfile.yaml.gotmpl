environments:
  default:
    values:
    - jx-values.yaml
---
helmDefaults:
  timeout: 600
repositories:
- name: jx3
  url: https://jenkins-x-charts.github.io/repo
- name: bitnami-oci
  url: registry-1.docker.io/bitnamicharts
  oci: true
- name: leartech-charts
  url: {{ requiredEnv "JX_CHART_REPOSITORY" }}
  oci: true

# Full preview stack (mirrors leartech-auth-ui/preview) PLUS a separate auth-ui
# release for the login form. auth-admin-ui is the OIDC client + admin portal;
# the Hydra login_challenge UI is served by auth-ui, so the two hosts differ:
#   - $adminHost = auth-admin-ui (this PR's build) — the OIDC client + callback
#   - $uiHost    = auth-ui (published chart)       — the login form
{{- $namespace := requiredEnv "PREVIEW_NAMESPACE" }}
{{- $prNum := requiredEnv "PULL_NUMBER" }}
{{- $appName := requiredEnv "APP_NAME" }}
{{- $domain := .Values.jxRequirements.ingress.domain }}
{{- $adminHost := printf "%s-pr%s.%s" $appName $prNum $domain }}
{{- $uiHost := printf "leartech-auth-ui-pr%s.%s" $prNum $domain }}
{{- $authHost := printf "leartech-auth-service-pr%s.%s" $prNum $domain }}
{{- $hydraHost := printf "hydra-pr%s.%s" $prNum $domain }}

releases:
# 1. JX verify
- chart: jx3/jx-verify
  name: jx-verify
  namespace: '{{ $namespace }}'

# 2. PostgreSQL — single instance, two DBs (hydra + auth_service).
- chart: bitnami-oci/postgresql
  version: 18.6.10
  name: auth-postgresql
  namespace: '{{ $namespace }}'
  values:
  - postgresql.yaml

# 3. Auth service (bundles Hydra + the seed Job — seeds platform@/admin@/test@).
# authUIURL + Hydra login URL point at the auth-ui host (the login form). CORS
# allows BOTH the admin-ui host (admin API calls) and the auth-ui host (login).
- chart: leartech-charts/leartech-auth-service
  version: ">=0.1.0"
  name: preview-auth-service
  namespace: '{{ $namespace }}'
  needs:
  - '{{ $namespace }}/auth-postgresql'
  values:
  - auth-service-values.yaml.gotmpl
  - ingress:
      annotations:
        nginx.ingress.kubernetes.io/enable-cors: "true"
        nginx.ingress.kubernetes.io/cors-allow-origin: 'https://{{ $adminHost }}, https://{{ $uiHost }}'
        nginx.ingress.kubernetes.io/cors-allow-credentials: "true"
        nginx.ingress.kubernetes.io/cors-allow-methods: "GET, POST, PUT, OPTIONS"
        nginx.ingress.kubernetes.io/cors-allow-headers: "Content-Type, Authorization"
  - jxRequirements:
      ingress:
        domain: '{{ $domain }}'
        namespaceSubDomain: '-pr{{ $prNum }}.'
  set:
  - name: authUIURL
    value: 'https://{{ $uiHost }}'
  - name: hydra.hydra.config.urls.self.issuer
    value: 'https://{{ $hydraHost }}'
  - name: hydra.hydra.config.urls.login
    value: 'https://{{ $uiHost }}/login'
  - name: hydra.hydra.config.urls.consent
    value: 'https://{{ $authHost }}/api/auth/consent'
  - name: hydra.hydra.config.urls.logout
    value: 'https://{{ $authHost }}/api/auth/logout'
  - name: hydra.ingress.public.hosts[0].host
    value: '{{ $hydraHost }}'
  - name: hydra.ingress.public.hosts[0].paths[0].path
    value: /
  - name: hydra.ingress.public.hosts[0].paths[0].pathType
    value: Prefix
  - name: hydra.hydra.config.serve.public.cors.enabled
    value: true
  - name: hydra.hydra.config.serve.public.cors.allowed_origins[0]
    value: 'https://{{ $adminHost }}'
  - name: hydra.hydra.config.serve.public.cors.allowed_origins[1]
    value: 'https://{{ $uiHost }}'

# 4. Auth UI (published chart) — serves the Hydra login_challenge form.
- chart: leartech-charts/leartech-auth-ui
  version: ">=0.0.1"
  name: preview-auth-ui
  namespace: '{{ $namespace }}'
  needs:
  - '{{ $namespace }}/preview-auth-service'
  set:
  # domain is REQUIRED for the leartech.ingress helper to render the ingress
  # (its guard checks jxRequirements.ingress.domain); without it auth-ui's login
  # host 404s. Host = service.name (leartech-auth-ui) + subdomain + domain =
  # uiHost, which Hydra's login URL points at.
  - name: jxRequirements.ingress.domain
    value: '{{ $domain }}'
  - name: jxRequirements.ingress.namespaceSubDomain
    value: '-pr{{ $prNum }}.'
  - name: config.api
    value: 'https://{{ $authHost }}'
  - name: config.auth.authority
    value: 'https://{{ $hydraHost }}'

# 5. Auth ADMIN UI (this PR's build) — the OIDC client + admin portal. Its
# /auth/callback is registered by end2end/01-register-oauth-client.sh (which
# uses PREVIEW_URL = this host). SDK basePath = config.peers.leartech-auth-service.
- chart: '../charts/{{ $appName }}'
  name: preview
  wait: true
  createNamespace: true
  namespace: '{{ $namespace }}'
  needs:
  - '{{ $namespace }}/preview-auth-service'
  - '{{ $namespace }}/preview-auth-ui'
  values:
  - jx-values.yaml
  - values.yaml.gotmpl
  set:
  - name: jxRequirements.ingress.namespaceSubDomain
    value: '-pr{{ $prNum }}.'
  - name: config.auth.authority
    value: 'https://{{ $hydraHost }}'
  - name: config.peers.leartech-auth-service
    value: 'https://{{ $authHost }}'
  hooks:
  - events: ["presync"]
    showlogs: true
    command: "jx"
    args:
    - secret
    - copy
    - --create-namespace
    - --selector
    - "secret.jenkins-x.io/replica-source=true"
    - --to
    - '{{ $namespace }}'

# 6. Preview gate — readiness checker for end2end (waits on Hydra discovery).
- chart: './charts/preview-gate'
  name: preview-gate
  namespace: '{{ $namespace }}'
  set:
  - name: expectedVersion
    value: '{{ requiredEnv "VERSION" }}'
  - name: httpProbes[0]
    value: 'https://{{ $hydraHost }}/.well-known/openid-configuration'
  # Also wait for the auth-ui login host to be serving (ingress + cert
  # propagation lags Hydra). Without this the OAuth flow's redirect to
  # $uiHost/login can 404 while auth-ui's ingress is still warming — the
  # exact race that failed 07-tenants (hydra was Ready, auth-ui wasn't).
  - name: httpProbes[1]
    value: 'https://{{ $uiHost }}/'
  # And wait for auth-service to be Ready (it restarts a couple times on cold
  # start). Without this, e2e can start before auth-service has warmed its JWKS
  # cache from Hydra, so the admin API rejects the (valid) bearer with 401 — the
  # flake that failed GCP 07-tenants on pr-9 and pr-11 (AZ warmed in time).
  - name: httpProbes[2]
    value: 'https://{{ $authHost }}/health/ready'

# Preview gives you:
#   https://leartech-auth-admin-ui-prN.<domain>  → admin portal (this PR's build)
#   https://leartech-auth-ui-prN.<domain>        → login form (published auth-ui)
#   https://leartech-auth-service-prN.<domain>   → Go auth service + /swagger
#   https://hydra-prN.<domain>                   → Hydra OAuth2
